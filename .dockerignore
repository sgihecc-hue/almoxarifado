# Fora do contexto de build: reduz o upload e evita vazar arquivo local
# dentro da imagem.
node_modules
dist
.git
.github
.claude
.vscode
*.log

# .env local NÃO entra na imagem: as variáveis do build vêm de build args
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY) definidos no EasyPanel.
# Se o .env entrasse, ele sobrescreveria os args e o container de teste
# poderia acabar apontando pro Supabase de produção.
.env
.env.*

supabase/.branches
supabase/.temp
